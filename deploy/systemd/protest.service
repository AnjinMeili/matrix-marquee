[Unit]
Description=MatrixMarquee RGB matrix signage appliance
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/protest/current
EnvironmentFile=/etc/protest/protest.env
ExecStart=/opt/protest/current/scripts/run-service.sh
ExecStartPre=/usr/bin/test -r /etc/protest/protest.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=protest
UMask=0027
StateDirectory=protest
StateDirectoryMode=0750
LogsDirectory=protest
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/protest /var/log/protest
WatchdogSec=0

[Install]
WantedBy=multi-user.target
