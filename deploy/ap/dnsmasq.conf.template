# Bind only to the explicitly selected AP interface, including late enumeration.
interface=@AP_INTERFACE@
bind-dynamic
listen-address=@AP_ADDRESS@
dhcp-range=@DHCP_START@,@DHCP_END@,255.255.255.0,12h
dhcp-option=3,@AP_ADDRESS@
dhcp-option=6,@AP_ADDRESS@
domain=@AP_HOSTNAME@.@AP_DOMAIN_SUFFIX@
local=/@AP_HOSTNAME@.@AP_DOMAIN_SUFFIX@/
address=/@AP_HOSTNAME@.@AP_DOMAIN_SUFFIX@/@AP_ADDRESS@
# Captive/offline appliance: resolve all names to the local portal.
address=/#/@AP_ADDRESS@
log-dhcp
log-queries=extra
