# Install as /etc/protest/ap.env with mode 0600.
AP_INTERFACE=wlan0
AP_SSID=MatrixMarquee
AP_PASSPHRASE=replace-with-at-least-12-characters
AP_COUNTRY=US
AP_CHANNEL=6
# Choose local or home.arpa; .home is not a supported local-use domain.
AP_DOMAIN_SUFFIX=local
AP_ADDRESS=10.42.0.1
DHCP_START=10.42.0.20
DHCP_END=10.42.0.200
