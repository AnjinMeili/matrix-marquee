# Legacy runtime config path retained for upgrade compatibility.
# Copy to /etc/protest/protest.env and keep that file mode 0600.

# Web service (read by scripts/run-service.sh and scripts/health-check.sh)
PROTEST_HOST=0.0.0.0
PROTEST_PORT=80
PROTEST_HEALTH_URL=http://127.0.0.1:80/health
PROTEST_APP_MODULE=matrix_player.app:app
PROTEST_WORKERS=1

# Application data and limits
MATRIX_PLAYER_DATA_DIR=/var/lib/protest
MATRIX_PLAYER_DATABASE=/var/lib/protest/matrix-player.sqlite3
MATRIX_PLAYER_MEDIA_DIR=/var/lib/protest/media
MATRIX_PLAYER_THUMBNAIL_DIR=/var/lib/protest/thumbnails
# Fitted frames (Fibonastretch animations and video) are worked out once and kept
# here; they can be deleted at any time and are rebuilt. Oldest are pruned past the limit.
MATRIX_PLAYER_FIT_CACHE_DIR=/var/lib/protest/fitted
MATRIX_PLAYER_FIT_CACHE_MAX_BYTES=1073741824
MATRIX_PLAYER_MAX_UPLOAD_BYTES=262144000
MATRIX_PLAYER_LOG_LEVEL=INFO

# Operator PIN, 4 to 12 digits. Phones that enter it in Settings may change the
# sign's settings (brightness, gamma, backups, logs) and, later, approve live
# input, for 12 hours. Until one is set, settings are open to anyone on the
# sign's Wi-Fi. It can be changed from Settings; editing it here always wins,
# which is how to recover a forgotten PIN.
# MATRIX_PLAYER_OPERATOR_PIN=

# Matrix output. "hardware" drives the panel; "mock" runs without GPIO for
# UI and API development. Width and height are the viewing orientation; signs
# can be any size, and everything drawn scales to it.
MATRIX_PLAYER_MATRIX_MODE=hardware
MATRIX_PLAYER_MATRIX_WIDTH=96
MATRIX_PLAYER_MATRIX_HEIGHT=64
# Start the enabled default playlist (resuming where it left off) at boot.
MATRIX_PLAYER_AUTOPLAY_DEFAULT=true

# Confirmed RGB matrix hardware profile. These values correspond exactly to:
# --led-rows=32 --led-cols=64 --led-chain=1 --led-parallel=3
# --led-multiplexing=1 --led-pixel-mapper="Rotate:90"
# --led-pwm-lsb-nanoseconds=160 --led-slowdown-gpio=2
MATRIX_ROWS=32
MATRIX_COLS=64
MATRIX_CHAIN_LENGTH=1
MATRIX_PARALLEL=3
MATRIX_MULTIPLEXING=1
MATRIX_PIXEL_MAPPER=Rotate:90
MATRIX_PWM_LSB_NANOSECONDS=160
MATRIX_GPIO_SLOWDOWN=2

# Shown on the Sign and Settings pages only; they do not configure networking.
# Set them to match /etc/protest/ap.env once scripts/setup-ap.sh has run.
# MATRIX_PLAYER_AP_SSID=MatrixMarquee
# MATRIX_PLAYER_AP_ACTIVE=true
# MATRIX_PLAYER_UPSTREAM_INTERFACE=eth0
